// MVP data model: users, conversations (1:1 or group), membership, messages.
// See docs/data-model.md for the ER diagram and the reasoning behind the
// non-obvious constraints (directKey, cascade vs SetNull).

generator client {
  provider      = "prisma-client-js"
  // Matches the two environments this ever runs in: your host (native, for
  // editor tooling if you generate there too) and the Debian-slim container
  // both Dockerfiles use.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  PRO
}

enum MessageKind {
  TEXT
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())

  createdConversations Conversation[]      @relation("ConversationCreatedBy")
  memberships          ConversationMember[]
  messages             Message[]
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  // Only set for GROUP conversations (DIRECT ones are named after the two members client-side).
  name        String?
  // "<smallerUserId>:<biggerUserId>" for DIRECT conversations, null for GROUP.
  // The unique constraint makes "at most one DM between two users" a database
  // guarantee instead of an application-level check with a race condition.
  directKey   String?          @unique
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy User?                 @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  // Drives the unread-count badge: messages in the conversation newer than this are unread.
  lastReadAt     DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String?
  content        String
  // TEXT = a real user message; SYSTEM = a group-mutation log entry
  // (senderId null in both cases) — this is what lets the client render
  // "Anyssa added Marko" centered/muted instead of as a chat bubble from
  // "Utilisateur supprimé". Defaults to TEXT so it backfills existing rows.
  kind           MessageKind @default(TEXT)
  createdAt      DateTime    @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  // Every message list query is "messages of this conversation, ordered by time" —
  // this index is what makes that pagination query fast instead of a full table scan.
  @@index([conversationId, createdAt])
}
