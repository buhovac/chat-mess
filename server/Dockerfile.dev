# Dev-only image: source is bind-mounted (see docker-compose.yml), this just
# gives every teammate the exact same Node + OS + npm regardless of their
# laptop. Nothing here is what ships to production — see ../Dockerfile.
FROM node:22-bookworm-slim

# Needed for Prisma's engine binaries on Debian-slim.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copied separately so `npm ci` is only re-run when deps actually change,
# not on every source-file edit.
COPY package*.json ./
RUN npm ci

COPY . .
# Generates node_modules/.prisma from prisma/schema.prisma so the image works
# on its own; docker-compose re-runs this at startup too (schema may change).
RUN npx prisma generate

EXPOSE 3001
CMD ["npm", "run", "dev"]
