# Dev-only image, same idea as server/Dockerfile.dev — identical Node/OS/npm
# for both of you, source bind-mounted from the host for instant edits.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
