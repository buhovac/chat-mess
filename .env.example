# Copy this file to .env and adjust if needed. .env is gitignored — never
# commit it. This .env.example IS committed so everyone starts from the same
# list of required variables. Default values are fine for local dev.

# --- Postgres (used by docker-compose to boot the db container) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- API (server/) ---
# docker-compose overrides this to point at the "db" service; the localhost
# value is only used if you ever run the api outside Docker.
DATABASE_URL=postgresql://app:app@localhost:5432/app
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:5173
